<?xml version="1.0"?>
<!--
    ekf_arena.world — Hamster-style maze made of simple box walls.
    Outer arena 7 x 6 m. Inner walls carve serpentine corridors. 4 ArUco
    markers pinned on the outer walls so they are always visible from at
    least one corridor location.
-->
<sdf version="1.9">
  <world name="default">

    <!-- Física a 100Hz (max_step_size=10ms): para Puzzlebot lento es más
         que suficiente (control ROS corre a 50Hz). Pasamos de 250→100Hz
         para liberar 2.5× más CPU al server. RTF=1.0 = realtime. -->
    <physics name="10ms" type="ignored">
      <max_step_size>0.010</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system"           name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"     name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <!-- Sensors usa ogre (Ogre1), no ogre2. Razón: con Mesa+llvmpipe
         Ogre2 NO renderiza ni texturas COLLADA ni PBR <albedo_map>;
         la cámara del robot publica una imagen plana de solo colores
         <ambient>/<diffuse>, y los markers ArUco quedan invisibles para
         OpenCV. Ogre1 sí renderiza texturas en sw render. -->
    <plugin filename="gz-sim-sensors-system"           name="gz::sim::systems::Sensors">
      <render_engine>ogre</render_engine>
    </plugin>

    <scene>
      <ambient>0.7 0.7 0.7 1</ambient>
      <background>0.55 0.65 0.80 1</background>
      <shadows>false</shadows>
    </scene>

    <light name="sun" type="directional">
      <pose>2.5 2 10 0 0 0</pose>
      <diffuse>1.0 1.0 1.0 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.3 -0.3 -1.0</direction>
      <cast_shadows>false</cast_shadows>
    </light>

    <!-- Floor: plain inline plane (same pattern as Week 6 bug_easy.world).
         No <include> dependency on model:// resource paths, so the world
         loads even if GZ_SIM_RESOURCE_PATH isn't set yet. -->
    <model name="ground_plane">
      <static>true</static>
      <pose>2.5 2.0 0 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
        </collision>
        <visual name="vis">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material>
            <ambient>0.55 0.40 0.25 1</ambient>
            <diffuse>0.70 0.50 0.30 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ── Outer walls (7 m x 6 m enclosure) ──────────────────────────── -->
    <model name="wall_south">
      <static>true</static>
      <pose>2.5 -1.0 0.30 0 0 0</pose>
      <link name="link">
        <visual name="v"><geometry><box><size>7.1 0.06 0.6</size></box></geometry>
          <material><ambient>0.65 0.50 0.32 1</ambient><diffuse>0.80 0.62 0.40 1</diffuse><specular>0.10 0.08 0.05 1</specular></material></visual>
        <collision name="c"><geometry><box><size>7.1 0.06 0.6</size></box></geometry></collision>
      </link>
    </model>

    <model name="wall_north">
      <static>true</static>
      <pose>2.5 5.0 0.30 0 0 0</pose>
      <link name="link">
        <visual name="v"><geometry><box><size>7.1 0.06 0.6</size></box></geometry>
          <material><ambient>0.65 0.50 0.32 1</ambient><diffuse>0.80 0.62 0.40 1</diffuse><specular>0.10 0.08 0.05 1</specular></material></visual>
        <collision name="c"><geometry><box><size>7.1 0.06 0.6</size></box></geometry></collision>
      </link>
    </model>

    <model name="wall_west">
      <static>true</static>
      <pose>-1.0 2.0 0.30 0 0 0</pose>
      <link name="link">
        <visual name="v"><geometry><box><size>0.06 6.1 0.6</size></box></geometry>
          <material><ambient>0.65 0.50 0.32 1</ambient><diffuse>0.80 0.62 0.40 1</diffuse><specular>0.10 0.08 0.05 1</specular></material></visual>
        <collision name="c"><geometry><box><size>0.06 6.1 0.6</size></box></geometry></collision>
      </link>
    </model>

    <model name="wall_east">
      <static>true</static>
      <pose>6.0 2.0 0.30 0 0 0</pose>
      <link name="link">
        <visual name="v"><geometry><box><size>0.06 6.1 0.6</size></box></geometry>
          <material><ambient>0.65 0.50 0.32 1</ambient><diffuse>0.80 0.62 0.40 1</diffuse><specular>0.10 0.08 0.05 1</specular></material></visual>
        <collision name="c"><geometry><box><size>0.06 6.1 0.6</size></box></geometry></collision>
      </link>
    </model>

    <!-- ── Inner walls — hamster corridors ────────────────────────────── -->
    <!-- iv1: top-left chamber -->
    <model name="iv1_west">
      <static>true</static>
      <pose>0.5 3.5 0.30 0 0 0</pose>
      <link name="link">
        <visual name="v"><geometry><box><size>0.06 1.6 0.6</size></box></geometry>
          <material><ambient>0.75 0.60 0.40 1</ambient><diffuse>0.90 0.74 0.50 1</diffuse></material></visual>
        <collision name="c"><geometry><box><size>0.06 1.6 0.6</size></box></geometry></collision>
      </link>
    </model>
    <model name="iv1_east">
      <static>true</static>
      <pose>1.8 3.5 0.30 0 0 0</pose>
      <link name="link">
        <visual name="v"><geometry><box><size>0.06 1.6 0.6</size></box></geometry>
          <material><ambient>0.75 0.60 0.40 1</ambient><diffuse>0.90 0.74 0.50 1</diffuse></material></visual>
        <collision name="c"><geometry><box><size>0.06 1.6 0.6</size></box></geometry></collision>
      </link>
    </model>
    <model name="iv1_top">
      <static>true</static>
      <pose>1.15 4.25 0.30 0 0 0</pose>
      <link name="link">
        <visual name="v"><geometry><box><size>1.3 0.06 0.6</size></box></geometry>
          <material><ambient>0.75 0.60 0.40 1</ambient><diffuse>0.90 0.74 0.50 1</diffuse></material></visual>
        <collision name="c"><geometry><box><size>1.3 0.06 0.6</size></box></geometry></collision>
      </link>
    </model>
    <model name="ih1">
      <static>true</static>
      <pose>0.95 3.6 0.30 0 0 0</pose>
      <link name="link">
        <visual name="v"><geometry><box><size>0.85 0.06 0.6</size></box></geometry>
          <material><ambient>0.75 0.60 0.40 1</ambient><diffuse>0.90 0.74 0.50 1</diffuse></material></visual>
        <collision name="c"><geometry><box><size>0.85 0.06 0.6</size></box></geometry></collision>
      </link>
    </model>

    <!-- iv4: top-right chamber -->
    <model name="iv4_west">
      <static>true</static>
      <pose>3.2 3.5 0.30 0 0 0</pose>
      <link name="link">
        <visual name="v"><geometry><box><size>0.06 1.6 0.6</size></box></geometry>
          <material><ambient>0.75 0.60 0.40 1</ambient><diffuse>0.90 0.74 0.50 1</diffuse></material></visual>
        <collision name="c"><geometry><box><size>0.06 1.6 0.6</size></box></geometry></collision>
      </link>
    </model>
    <model name="iv4_east">
      <static>true</static>
      <pose>4.5 3.5 0.30 0 0 0</pose>
      <link name="link">
        <visual name="v"><geometry><box><size>0.06 1.6 0.6</size></box></geometry>
          <material><ambient>0.75 0.60 0.40 1</ambient><diffuse>0.90 0.74 0.50 1</diffuse></material></visual>
        <collision name="c"><geometry><box><size>0.06 1.6 0.6</size></box></geometry></collision>
      </link>
    </model>
    <model name="iv4_top">
      <static>true</static>
      <pose>3.85 4.25 0.30 0 0 0</pose>
      <link name="link">
        <visual name="v"><geometry><box><size>1.3 0.06 0.6</size></box></geometry>
          <material><ambient>0.75 0.60 0.40 1</ambient><diffuse>0.90 0.74 0.50 1</diffuse></material></visual>
        <collision name="c"><geometry><box><size>1.3 0.06 0.6</size></box></geometry></collision>
      </link>
    </model>
    <model name="ih3">
      <static>true</static>
      <pose>4.10 3.6 0.30 0 0 0</pose>
      <link name="link">
        <visual name="v"><geometry><box><size>0.85 0.06 0.6</size></box></geometry>
          <material><ambient>0.75 0.60 0.40 1</ambient><diffuse>0.90 0.74 0.50 1</diffuse></material></visual>
        <collision name="c"><geometry><box><size>0.85 0.06 0.6</size></box></geometry></collision>
      </link>
    </model>

    <!-- mid dividers -->
    <model name="ih2_left">
      <static>true</static>
      <pose>0.30 2.0 0.30 0 0 0</pose>
      <link name="link">
        <visual name="v"><geometry><box><size>2.2 0.06 0.6</size></box></geometry>
          <material><ambient>0.75 0.60 0.40 1</ambient><diffuse>0.90 0.74 0.50 1</diffuse></material></visual>
        <collision name="c"><geometry><box><size>2.2 0.06 0.6</size></box></geometry></collision>
      </link>
    </model>
    <model name="ih2_right">
      <static>true</static>
      <pose>3.50 2.0 0.30 0 0 0</pose>
      <link name="link">
        <visual name="v"><geometry><box><size>2.2 0.06 0.6</size></box></geometry>
          <material><ambient>0.75 0.60 0.40 1</ambient><diffuse>0.90 0.74 0.50 1</diffuse></material></visual>
        <collision name="c"><geometry><box><size>2.2 0.06 0.6</size></box></geometry></collision>
      </link>
    </model>

    <!-- iv2: bottom-left chamber -->
    <model name="iv2_west">
      <static>true</static>
      <pose>0.5 0.5 0.30 0 0 0</pose>
      <link name="link">
        <visual name="v"><geometry><box><size>0.06 1.6 0.6</size></box></geometry>
          <material><ambient>0.75 0.60 0.40 1</ambient><diffuse>0.90 0.74 0.50 1</diffuse></material></visual>
        <collision name="c"><geometry><box><size>0.06 1.6 0.6</size></box></geometry></collision>
      </link>
    </model>
    <model name="iv2_east">
      <static>true</static>
      <pose>1.8 0.5 0.30 0 0 0</pose>
      <link name="link">
        <visual name="v"><geometry><box><size>0.06 1.6 0.6</size></box></geometry>
          <material><ambient>0.75 0.60 0.40 1</ambient><diffuse>0.90 0.74 0.50 1</diffuse></material></visual>
        <collision name="c"><geometry><box><size>0.06 1.6 0.6</size></box></geometry></collision>
      </link>
    </model>
    <model name="iv2_bottom">
      <static>true</static>
      <pose>1.15 -0.25 0.30 0 0 0</pose>
      <link name="link">
        <visual name="v"><geometry><box><size>1.3 0.06 0.6</size></box></geometry>
          <material><ambient>0.75 0.60 0.40 1</ambient><diffuse>0.90 0.74 0.50 1</diffuse></material></visual>
        <collision name="c"><geometry><box><size>1.3 0.06 0.6</size></box></geometry></collision>
      </link>
    </model>

    <!-- iv3: bottom-right chamber -->
    <model name="iv3_west">
      <static>true</static>
      <pose>3.2 0.5 0.30 0 0 0</pose>
      <link name="link">
        <visual name="v"><geometry><box><size>0.06 1.6 0.6</size></box></geometry>
          <material><ambient>0.75 0.60 0.40 1</ambient><diffuse>0.90 0.74 0.50 1</diffuse></material></visual>
        <collision name="c"><geometry><box><size>0.06 1.6 0.6</size></box></geometry></collision>
      </link>
    </model>
    <model name="iv3_east">
      <static>true</static>
      <pose>4.5 0.5 0.30 0 0 0</pose>
      <link name="link">
        <visual name="v"><geometry><box><size>0.06 1.6 0.6</size></box></geometry>
          <material><ambient>0.75 0.60 0.40 1</ambient><diffuse>0.90 0.74 0.50 1</diffuse></material></visual>
        <collision name="c"><geometry><box><size>0.06 1.6 0.6</size></box></geometry></collision>
      </link>
    </model>
    <model name="iv3_bottom">
      <static>true</static>
      <pose>3.85 -0.25 0.30 0 0 0</pose>
      <link name="link">
        <visual name="v"><geometry><box><size>1.3 0.06 0.6</size></box></geometry>
          <material><ambient>0.75 0.60 0.40 1</ambient><diffuse>0.90 0.74 0.50 1</diffuse></material></visual>
        <collision name="c"><geometry><box><size>1.3 0.06 0.6</size></box></geometry></collision>
      </link>
    </model>

    <!-- ── ArUco markers ─────────────────────────────────────────────── -->
    <!-- Markers en paredes INTERIORES del laberinto, posicionados con
         línea de vista directa desde el corredor central (1.9, 2.0).
         Mirando norte: marker_1 (ih1 cara sur) y marker_2 (ih3 cara sur).
         Mirando sur: marker_0 (ih2_left cara sur) y marker_3 (ih2_right
         cara sur). Pivoteando el robot en su sitio ve los 4. -->
    <!-- Markers separados 5 cm de la pared para evitar z-fighting con el
         visual del muro. Cara sur (mira -Y): pose Y = wall_Y - 0.05.
         Cara norte (mira +Y): pose Y = wall_Y + 0.05. -->
    <include>
      <name>marker_1</name>
      <uri>model://aruco_marker_1</uri>
      <pose>0.6 1.92 0.30 0 0 -1.5708</pose>
    </include>
    <include>
      <name>marker_2</name>
      <uri>model://aruco_marker_2</uri>
      <pose>4.4 1.92 0.30 0 0 -1.5708</pose>
    </include>
    <include>
      <name>marker_0</name>
      <uri>model://aruco_marker_0</uri>
      <pose>0.6 2.08 0.30 0 0 1.5708</pose>
    </include>
    <include>
      <name>marker_3</name>
      <uri>model://aruco_marker_3</uri>
      <pose>4.4 2.08 0.30 0 0 1.5708</pose>
    </include>

    <!-- ── ArUcos EXTRA (Sección B opcional, cobertura completa) ──────────
         Markers id 4-9 colocados en los muros EXTERIORES, despegados 3cm
         de la pared. Los orientamos con la cara texturizada APUNTANDO HACIA
         EL INTERIOR del laberinto (con offset +π/2 vs la normal del muro,
         porque el plano <aruco_face> del SDF está rotado internamente).
         Cobertura validada (≤2.5m desde cada wp):
           p0(1.9,0.0)  → markers 0,1 (muro central, mirando sur)
           p1(5.2,2.0)  → markers 2,3,4,5 (muro este)
           p2(1.9,4.7)  → markers 8,9 (muro norte)
           p3(-0.5,2.0) → markers 0,1,6,7 (muro central + oeste)
         OFFSET DE YAW: en los markers del muro central (0,1,2,3) yaw vale
         ±π/2 que coincide con el yaw del plano interno. Para los muros
         exteriores aplicamos el mismo signo de orientación con offset π/2.
    -->
    <!-- wall_east (x=6.0): textura mirando al OESTE = -X.
         yaw = π/2 + π/2 = π ya que el plano interno está girado π/2 -->
    <include>
      <name>marker_4</name>
      <uri>model://aruco_marker_4</uri>
      <pose>5.94 1.0 0.30 0 0 3.14159</pose>
    </include>
    <include>
      <name>marker_5</name>
      <uri>model://aruco_marker_5</uri>
      <pose>5.94 3.0 0.30 0 0 3.14159</pose>
    </include>
    <!-- wall_west (x=-1.0): textura mirando al ESTE = +X (yaw=0) -->
    <include>
      <name>marker_6</name>
      <uri>model://aruco_marker_6</uri>
      <pose>-0.94 1.5 0.30 0 0 0</pose>
    </include>
    <include>
      <name>marker_7</name>
      <uri>model://aruco_marker_7</uri>
      <pose>-0.94 3.0 0.30 0 0 0</pose>
    </include>
    <!-- wall_north (y=5.0): textura mirando al SUR = -Y (yaw=-π/2) -->
    <include>
      <name>marker_8</name>
      <uri>model://aruco_marker_8</uri>
      <pose>1.0 4.94 0.30 0 0 -1.5708</pose>
    </include>
    <include>
      <name>marker_9</name>
      <uri>model://aruco_marker_9</uri>
      <pose>4.0 4.94 0.30 0 0 -1.5708</pose>
    </include>

    <!-- ── ArUcos DENTRO de cada chamber (ids 10-13, landmark interior) ──
         Estrategia SLAM: markers en el muro interior del cierre de cada
         chamber, mirando hacia afuera del chamber por su apertura.
         iv1 abre al SUR → m10 en su iv1_top interior mira al SUR
         iv2 abre al NORTE → m11 en su iv2_bottom interior mira al NORTE
         iv3 abre al NORTE → m12 en su iv3_bottom interior mira al NORTE
         iv4 abre al SUR → m13 en su iv4_top interior mira al SUR

         El robot los ve desde el corredor exterior cercano al chamber,
         dando observación de MÚLTIPLES markers simultáneamente (PDF
         escenario 5.1). Cobertura: cada waypoint ve 4-6 markers. -->
    <include>
      <name>marker_10</name>
      <uri>model://aruco_marker_10</uri>
      <pose>1.15 4.22 0.30 0 0 -1.5708</pose>
    </include>
    <include>
      <name>marker_11</name>
      <uri>model://aruco_marker_11</uri>
      <pose>1.15 -0.22 0.30 0 0 1.5708</pose>
    </include>
    <include>
      <name>marker_12</name>
      <uri>model://aruco_marker_12</uri>
      <pose>3.85 -0.22 0.30 0 0 1.5708</pose>
    </include>
    <!-- m13 en esquina IZQUIERDA de ih2_right (muro divisorio derecho).
         ih2_right cubre x∈[2.4, 4.6] en y=2.0. m13 va en su esquina
         izquierda (x=2.4) cara NORTE (y=2.08, mira al norte yaw=+π/2).
         Simétrico al m0 que está en la otra punta (0.6, 2.08).
         Cobertura validada: 5 puntos de la trayectoria lo ven, en
         particular CENTRADO desde WP2 mirando al sur (preparando WP3). -->
    <include>
      <name>marker_13</name>
      <uri>model://aruco_marker_13</uri>
      <pose>2.4 2.08 0.30 0 0 1.5708</pose>
    </include>

    <!-- Markers 14-16 REMOVIDOS: estaban embebidos físicamente dentro
         de las paredes iv2_east, iv3_west, iv4_west. El detector ArUco
         los reportaba pero el EKF rechazaba el 99% de las observaciones
         por mismatch de geometría (innovation > gate Mahalanobis).
         Los 14 markers originales (0-13) dan cobertura suficiente para
         los 5 tramos de la trayectoria cerrada. -->


    <!-- ── Waypoints de Part 2 (banderas verdes visibles en Gazebo) ────
         4 puntos v5 INTERIOR-SAFE: todos con margen ≥0.5m a cualquier
         muro. v4 ponía WP en bordes (y=0.0, y=4.7) donde el robot se
         pasaba por inercia hacia zonas muertas. v5 los centra en los
         patios entre chambers Y alterna norte/sur del divisor para
         forzar el cruce del gap central 2 veces.
         Solo visual, sin colisión. -->
    <include>
      <name>wp0_flag</name>
      <uri>model://goal_flag</uri>
      <pose>2.5 0.5 0 0 0 0</pose>
    </include>
    <include>
      <name>wp1_flag</name>
      <uri>model://goal_flag</uri>
      <pose>5.2 2.5 0 0 0 0</pose>
    </include>
    <include>
      <name>wp2_flag</name>
      <uri>model://goal_flag</uri>
      <pose>2.5 3.5 0 0 0 0</pose>
    </include>
    <include>
      <name>wp3_flag</name>
      <uri>model://goal_flag</uri>
      <pose>-0.5 1.5 0 0 0 0</pose>
    </include>

  </world>
</sdf>
