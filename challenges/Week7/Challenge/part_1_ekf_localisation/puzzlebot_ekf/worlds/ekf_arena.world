<?xml version="1.0"?>
<!--
    ekf_arena.world — Hamster-style maze made of simple box walls.
    Outer arena 7 x 6 m. Inner walls carve serpentine corridors. 4 ArUco
    markers pinned on the outer walls so they are always visible from at
    least one corridor location.
-->
<sdf version="1.9">
  <world name="default">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system"           name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"     name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <!-- Sensors usa ogre (Ogre1), no ogre2. Razón: con Mesa+llvmpipe
         Ogre2 NO renderiza ni texturas COLLADA ni PBR <albedo_map>;
         la cámara del robot publica una imagen plana de solo colores
         <ambient>/<diffuse>, y los markers ArUco quedan invisibles para
         OpenCV. Ogre1 sí renderiza texturas en sw render. -->
    <plugin filename="gz-sim-sensors-system"           name="gz::sim::systems::Sensors">
      <render_engine>ogre</render_engine>
    </plugin>

    <scene>
      <ambient>0.7 0.7 0.7 1</ambient>
      <background>0.55 0.65 0.80 1</background>
      <shadows>false</shadows>
    </scene>

    <light name="sun" type="directional">
      <pose>2.5 2 10 0 0 0</pose>
      <diffuse>1.0 1.0 1.0 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.3 -0.3 -1.0</direction>
      <cast_shadows>false</cast_shadows>
    </light>

    <!-- Floor: plain inline plane (same pattern as Week 6 bug_easy.world).
         No <include> dependency on model:// resource paths, so the world
         loads even if GZ_SIM_RESOURCE_PATH isn't set yet. -->
    <model name="ground_plane">
      <static>true</static>
      <pose>2.5 2.0 0 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
        </collision>
        <visual name="vis">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material>
            <ambient>0.55 0.40 0.25 1</ambient>
            <diffuse>0.70 0.50 0.30 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ── Outer walls (7 m x 6 m enclosure) ──────────────────────────── -->
    <model name="wall_south">
      <static>true</static>
      <pose>2.5 -1.0 0.30 0 0 0</pose>
      <link name="link">
        <visual name="v"><geometry><box><size>7.1 0.06 0.6</size></box></geometry>
          <material><ambient>0.65 0.50 0.32 1</ambient><diffuse>0.80 0.62 0.40 1</diffuse><specular>0.10 0.08 0.05 1</specular></material></visual>
        <collision name="c"><geometry><box><size>7.1 0.06 0.6</size></box></geometry></collision>
      </link>
    </model>

    <model name="wall_north">
      <static>true</static>
      <pose>2.5 5.0 0.30 0 0 0</pose>
      <link name="link">
        <visual name="v"><geometry><box><size>7.1 0.06 0.6</size></box></geometry>
          <material><ambient>0.65 0.50 0.32 1</ambient><diffuse>0.80 0.62 0.40 1</diffuse><specular>0.10 0.08 0.05 1</specular></material></visual>
        <collision name="c"><geometry><box><size>7.1 0.06 0.6</size></box></geometry></collision>
      </link>
    </model>

    <model name="wall_west">
      <static>true</static>
      <pose>-1.0 2.0 0.30 0 0 0</pose>
      <link name="link">
        <visual name="v"><geometry><box><size>0.06 6.1 0.6</size></box></geometry>
          <material><ambient>0.65 0.50 0.32 1</ambient><diffuse>0.80 0.62 0.40 1</diffuse><specular>0.10 0.08 0.05 1</specular></material></visual>
        <collision name="c"><geometry><box><size>0.06 6.1 0.6</size></box></geometry></collision>
      </link>
    </model>

    <model name="wall_east">
      <static>true</static>
      <pose>6.0 2.0 0.30 0 0 0</pose>
      <link name="link">
        <visual name="v"><geometry><box><size>0.06 6.1 0.6</size></box></geometry>
          <material><ambient>0.65 0.50 0.32 1</ambient><diffuse>0.80 0.62 0.40 1</diffuse><specular>0.10 0.08 0.05 1</specular></material></visual>
        <collision name="c"><geometry><box><size>0.06 6.1 0.6</size></box></geometry></collision>
      </link>
    </model>

    <!-- ── Inner walls — hamster corridors ────────────────────────────── -->
    <!-- iv1: top-left chamber -->
    <model name="iv1_west">
      <static>true</static>
      <pose>0.5 3.5 0.30 0 0 0</pose>
      <link name="link">
        <visual name="v"><geometry><box><size>0.06 1.6 0.6</size></box></geometry>
          <material><ambient>0.75 0.60 0.40 1</ambient><diffuse>0.90 0.74 0.50 1</diffuse></material></visual>
        <collision name="c"><geometry><box><size>0.06 1.6 0.6</size></box></geometry></collision>
      </link>
    </model>
    <model name="iv1_east">
      <static>true</static>
      <pose>1.8 3.5 0.30 0 0 0</pose>
      <link name="link">
        <visual name="v"><geometry><box><size>0.06 1.6 0.6</size></box></geometry>
          <material><ambient>0.75 0.60 0.40 1</ambient><diffuse>0.90 0.74 0.50 1</diffuse></material></visual>
        <collision name="c"><geometry><box><size>0.06 1.6 0.6</size></box></geometry></collision>
      </link>
    </model>
    <model name="iv1_top">
      <static>true</static>
      <pose>1.15 4.25 0.30 0 0 0</pose>
      <link name="link">
        <visual name="v"><geometry><box><size>1.3 0.06 0.6</size></box></geometry>
          <material><ambient>0.75 0.60 0.40 1</ambient><diffuse>0.90 0.74 0.50 1</diffuse></material></visual>
        <collision name="c"><geometry><box><size>1.3 0.06 0.6</size></box></geometry></collision>
      </link>
    </model>
    <model name="ih1">
      <static>true</static>
      <pose>0.95 3.6 0.30 0 0 0</pose>
      <link name="link">
        <visual name="v"><geometry><box><size>0.85 0.06 0.6</size></box></geometry>
          <material><ambient>0.75 0.60 0.40 1</ambient><diffuse>0.90 0.74 0.50 1</diffuse></material></visual>
        <collision name="c"><geometry><box><size>0.85 0.06 0.6</size></box></geometry></collision>
      </link>
    </model>

    <!-- iv4: top-right chamber -->
    <model name="iv4_west">
      <static>true</static>
      <pose>3.2 3.5 0.30 0 0 0</pose>
      <link name="link">
        <visual name="v"><geometry><box><size>0.06 1.6 0.6</size></box></geometry>
          <material><ambient>0.75 0.60 0.40 1</ambient><diffuse>0.90 0.74 0.50 1</diffuse></material></visual>
        <collision name="c"><geometry><box><size>0.06 1.6 0.6</size></box></geometry></collision>
      </link>
    </model>
    <model name="iv4_east">
      <static>true</static>
      <pose>4.5 3.5 0.30 0 0 0</pose>
      <link name="link">
        <visual name="v"><geometry><box><size>0.06 1.6 0.6</size></box></geometry>
          <material><ambient>0.75 0.60 0.40 1</ambient><diffuse>0.90 0.74 0.50 1</diffuse></material></visual>
        <collision name="c"><geometry><box><size>0.06 1.6 0.6</size></box></geometry></collision>
      </link>
    </model>
    <model name="iv4_top">
      <static>true</static>
      <pose>3.85 4.25 0.30 0 0 0</pose>
      <link name="link">
        <visual name="v"><geometry><box><size>1.3 0.06 0.6</size></box></geometry>
          <material><ambient>0.75 0.60 0.40 1</ambient><diffuse>0.90 0.74 0.50 1</diffuse></material></visual>
        <collision name="c"><geometry><box><size>1.3 0.06 0.6</size></box></geometry></collision>
      </link>
    </model>
    <model name="ih3">
      <static>true</static>
      <pose>4.10 3.6 0.30 0 0 0</pose>
      <link name="link">
        <visual name="v"><geometry><box><size>0.85 0.06 0.6</size></box></geometry>
          <material><ambient>0.75 0.60 0.40 1</ambient><diffuse>0.90 0.74 0.50 1</diffuse></material></visual>
        <collision name="c"><geometry><box><size>0.85 0.06 0.6</size></box></geometry></collision>
      </link>
    </model>

    <!-- mid dividers -->
    <model name="ih2_left">
      <static>true</static>
      <pose>0.30 2.0 0.30 0 0 0</pose>
      <link name="link">
        <visual name="v"><geometry><box><size>2.2 0.06 0.6</size></box></geometry>
          <material><ambient>0.75 0.60 0.40 1</ambient><diffuse>0.90 0.74 0.50 1</diffuse></material></visual>
        <collision name="c"><geometry><box><size>2.2 0.06 0.6</size></box></geometry></collision>
      </link>
    </model>
    <model name="ih2_right">
      <static>true</static>
      <pose>3.50 2.0 0.30 0 0 0</pose>
      <link name="link">
        <visual name="v"><geometry><box><size>2.2 0.06 0.6</size></box></geometry>
          <material><ambient>0.75 0.60 0.40 1</ambient><diffuse>0.90 0.74 0.50 1</diffuse></material></visual>
        <collision name="c"><geometry><box><size>2.2 0.06 0.6</size></box></geometry></collision>
      </link>
    </model>

    <!-- iv2: bottom-left chamber -->
    <model name="iv2_west">
      <static>true</static>
      <pose>0.5 0.5 0.30 0 0 0</pose>
      <link name="link">
        <visual name="v"><geometry><box><size>0.06 1.6 0.6</size></box></geometry>
          <material><ambient>0.75 0.60 0.40 1</ambient><diffuse>0.90 0.74 0.50 1</diffuse></material></visual>
        <collision name="c"><geometry><box><size>0.06 1.6 0.6</size></box></geometry></collision>
      </link>
    </model>
    <model name="iv2_east">
      <static>true</static>
      <pose>1.8 0.5 0.30 0 0 0</pose>
      <link name="link">
        <visual name="v"><geometry><box><size>0.06 1.6 0.6</size></box></geometry>
          <material><ambient>0.75 0.60 0.40 1</ambient><diffuse>0.90 0.74 0.50 1</diffuse></material></visual>
        <collision name="c"><geometry><box><size>0.06 1.6 0.6</size></box></geometry></collision>
      </link>
    </model>
    <model name="iv2_bottom">
      <static>true</static>
      <pose>1.15 -0.25 0.30 0 0 0</pose>
      <link name="link">
        <visual name="v"><geometry><box><size>1.3 0.06 0.6</size></box></geometry>
          <material><ambient>0.75 0.60 0.40 1</ambient><diffuse>0.90 0.74 0.50 1</diffuse></material></visual>
        <collision name="c"><geometry><box><size>1.3 0.06 0.6</size></box></geometry></collision>
      </link>
    </model>

    <!-- iv3: bottom-right chamber -->
    <model name="iv3_west">
      <static>true</static>
      <pose>3.2 0.5 0.30 0 0 0</pose>
      <link name="link">
        <visual name="v"><geometry><box><size>0.06 1.6 0.6</size></box></geometry>
          <material><ambient>0.75 0.60 0.40 1</ambient><diffuse>0.90 0.74 0.50 1</diffuse></material></visual>
        <collision name="c"><geometry><box><size>0.06 1.6 0.6</size></box></geometry></collision>
      </link>
    </model>
    <model name="iv3_east">
      <static>true</static>
      <pose>4.5 0.5 0.30 0 0 0</pose>
      <link name="link">
        <visual name="v"><geometry><box><size>0.06 1.6 0.6</size></box></geometry>
          <material><ambient>0.75 0.60 0.40 1</ambient><diffuse>0.90 0.74 0.50 1</diffuse></material></visual>
        <collision name="c"><geometry><box><size>0.06 1.6 0.6</size></box></geometry></collision>
      </link>
    </model>
    <model name="iv3_bottom">
      <static>true</static>
      <pose>3.85 -0.25 0.30 0 0 0</pose>
      <link name="link">
        <visual name="v"><geometry><box><size>1.3 0.06 0.6</size></box></geometry>
          <material><ambient>0.75 0.60 0.40 1</ambient><diffuse>0.90 0.74 0.50 1</diffuse></material></visual>
        <collision name="c"><geometry><box><size>1.3 0.06 0.6</size></box></geometry></collision>
      </link>
    </model>

    <!-- ── ArUco markers ─────────────────────────────────────────────── -->
    <!-- Markers en paredes INTERIORES del laberinto, posicionados con
         línea de vista directa desde el corredor central (1.9, 2.0).
         Mirando norte: marker_1 (ih1 cara sur) y marker_2 (ih3 cara sur).
         Mirando sur: marker_0 (ih2_left cara sur) y marker_3 (ih2_right
         cara sur). Pivoteando el robot en su sitio ve los 4. -->
    <!-- Markers separados 5 cm de la pared para evitar z-fighting con el
         visual del muro. Cara sur (mira -Y): pose Y = wall_Y - 0.05.
         Cara norte (mira +Y): pose Y = wall_Y + 0.05. -->
    <include>
      <name>marker_1</name>
      <uri>model://aruco_marker_1</uri>
      <pose>0.6 1.92 0.30 0 0 -1.5708</pose>
    </include>
    <include>
      <name>marker_2</name>
      <uri>model://aruco_marker_2</uri>
      <pose>4.4 1.92 0.30 0 0 -1.5708</pose>
    </include>
    <include>
      <name>marker_0</name>
      <uri>model://aruco_marker_0</uri>
      <pose>0.6 2.08 0.30 0 0 1.5708</pose>
    </include>
    <include>
      <name>marker_3</name>
      <uri>model://aruco_marker_3</uri>
      <pose>4.4 2.08 0.30 0 0 1.5708</pose>
    </include>

  </world>
</sdf>
