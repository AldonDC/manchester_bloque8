<?xml version="1.0" ?>
<sdf version="1.9">
    <model name="puzzlebot_base">
        <static>true</static>
        <link name="link">
            <collision name="collision">
                <geometry>
                    <plane>
                        <normal>0 0 1</normal>
                        <size>10.0 10.0</size>
                    </plane>
                </geometry>
                <surface>
                    <contact>
                        <collide_bitmask>0xffff</collide_bitmask>
                    </contact>
                    <friction>
                        <ode>
                            <mu>100</mu>
                            <mu2>50</mu2>
                        </ode>
                    </friction>
                </surface>
            </collision>

            <visual name="puzzlebot_visual">
                <pose>0 0 0.001 0 0 0</pose>
                <cast_shadows>false</cast_shadows>
                <geometry>
                    <plane>
                        <normal>0 0 1</normal>
                        <size>8.0 8.0</size>
                    </plane>
                </geometry>

                <material>
                    <ambient>0.55 0.40 0.25 1</ambient>
                    <diffuse>0.70 0.50 0.30 1</diffuse>
                    <specular>0.05 0.05 0.05 1</specular>
                </material>
            </visual>
        </link>
    </model>
</sdf>